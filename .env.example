# Valores secretos somente no servidor, nunca no GitHub.
GEMINI_API_KEY=""
APP_URL="http://127.0.0.1:3000"

# ID público do agente, configurar antes do build.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=""

# JSON completo da conta de serviço do projeto de firebase-applet-config.json.
# Configurar no gerenciador de segredos da hospedagem.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Segredo aleatório forte, mínimo 32 caracteres. Igual à credencial Header Auth
# x-webhook-secret do n8n. Não utilizar NEXT_PUBLIC_ para segredos.
AGENT_API_SECRET=""

# O outro segredo, x-ali-webhook-key, fica somente no ElevenLabs e n8n.

# Google (Agenda e Gmail de cada nutricionista). Cliente OAuth do tipo "Aplicativo da Web"
# do Google Cloud, com o endereço de retorno abaixo cadastrado.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://app.nutriali.cloud/api/google/callback"
# Segredo aleatório forte (mínimo 32 caracteres) que criptografa as autorizações guardadas.
# Se for trocado, cada nutricionista precisa conectar o Google de novo.
GOOGLE_TOKEN_KEY=""
