# Valores secretos somente no servidor, nunca no GitHub.

# IA dos chats, planos, dica do dia e análise de refeição: chave da Groq (console.groq.com).
GROQ_API_KEY=""
# Opcionais: trocam o modelo sem mexer no código (a Groq muda os modelos com frequência).
# GROQ_MODEL="openai/gpt-oss-120b"
# GROQ_VISION_MODEL="qwen/qwen3.8-27b"
# IA reserva: só é usada quando GROQ_API_KEY está vazia.
GEMINI_API_KEY=""
APP_URL="http://127.0.0.1:3000"

# ID público do agente, configurar antes do build.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=""

# Chave de API da ElevenLabs (elevenlabs.io → Developers → API Keys), de preferência com acesso só a ElevenAgents.
# Com ela o servidor emite a credencial de cada conversa da Ali para quem está logado, e os agentes podem exigir
# autenticação. Vazia, as telas usam só o ID do agente (funciona enquanto o agente for público).
ELEVENLABS_API_KEY=""

# JSON completo da conta de serviço do projeto de firebase-applet-config.json.
# Configurar no gerenciador de segredos da hospedagem.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Segredo aleatório forte, mínimo 32 caracteres. Igual à credencial Header Auth
# x-webhook-secret do n8n. Não utilizar NEXT_PUBLIC_ para segredos.
AGENT_API_SECRET=""

# O outro segredo, x-ali-webhook-key, fica somente no ElevenLabs e n8n.

# E-mail de quem aprova o cadastro de nutricionistas (pode ser mais de um, separados por vírgula). Não é segredo.
# A pessoa precisa entrar no app com o Google usando esse e-mail (é assim que o app confirma que o e-mail é dela)
# e, para os avisos saírem por e-mail, ter o Google conectado em "Minha Ali". Vazia, ninguém consegue aprovar:
# as nutricionistas novas ficam "em análise" até a variável ser preenchida.
ADMIN_EMAILS=""

# Google (Agenda e Gmail de cada nutricionista). Cliente OAuth do tipo "Aplicativo da Web"
# do Google Cloud, com o endereço de retorno abaixo cadastrado.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://app.nutriali.cloud/api/google/callback"
# Segredo aleatório forte (mínimo 32 caracteres) que criptografa as autorizações guardadas.
# Se for trocado, cada nutricionista precisa conectar o Google de novo.
GOOGLE_TOKEN_KEY=""
