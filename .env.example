# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_KEY: JSON da conta de serviço (Firebase Console →
# Configurações do projeto → Contas de serviço → Gerar nova chave privada).
# Usado pelo webhook da ElevenLabs (app/api/elevenlabs/patient) para consultar
# pacientes com as regras restritas do Firestore.
FIREBASE_SERVICE_ACCOUNT_KEY="MY_FIREBASE_SERVICE_ACCOUNT_JSON"

# ELEVENLABS_WEBHOOK_SECRET: segredo compartilhado enviado pela ElevenLabs no
# header "x-webhook-secret". Recomendado para impedir chamadas não autorizadas.
ELEVENLABS_WEBHOOK_SECRET="MY_WEBHOOK_SECRET"
