rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isNutritionist() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'nutritionist';
    }

    // Each user can only read/write their own profile document.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Patient records: the patient can read only their own record.
    // Nutritionists can read and manage all patient records.
    match /patients/{patientId} {
      allow read: if isSignedIn() && (request.auth.uid == patientId || isNutritionist());
      allow create, update, delete: if isNutritionist();
    }

    // Food diary entries logged by the patient via Ali.
    // Rules do NOT cascade into subcollections, so foodLogs needs its own match.
    // The patient reads only their own entries; nutritionists read all.
    // Writes are done exclusively by the Ali action API (Admin SDK), never by clients.
    match /patients/{patientId}/foodLogs/{logId} {
      allow read: if isSignedIn() && (request.auth.uid == patientId || isNutritionist());
      allow write: if false;
    }

    // Appointment requests created by Ali on behalf of patients.
    // Patients see their own requests; nutritionists read everything and can
    // update (approve/reschedule). Creation/deletion only via Admin SDK.
    match /appointmentRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid || isNutritionist());
      allow update: if isNutritionist();
      allow create, delete: if false;
    }

    // Audit trail of AI actions (Ali). Nutritionists can read it for
    // transparency; NOBODY can write from clients, preserving log integrity.
    match /aiActions/{actionId} {
      allow read: if isNutritionist();
      allow write: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
