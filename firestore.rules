rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isNutritionist() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'nutritionist';
    }

    // Each user can only read/write their own profile document.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Patient records: the patient can read only their own record.
    // Nutritionists can read and manage all patient records.
    match /patients/{patientId} {
      allow read: if isSignedIn() && (request.auth.uid == patientId || isNutritionist());
      allow create, update, delete: if isNutritionist();
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
